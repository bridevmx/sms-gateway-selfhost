# Copia estos nombres a las variables de entorno del recurso en Coolify.
# NUNCA subas un .env real al repositorio. Genera cada secreto con:
#   openssl rand -base64 32

# Debe coincidir EXACTAMENTE con el "Private Token" que pondrás en la app Android.
GATEWAY_PRIVATE_TOKEN=cambia-esto

DB_NAME=sms
DB_USER=sms
DB_PASSWORD=cambia-esto
DB_ROOT_PASSWORD=cambia-esto

# Versión de la imagen del servidor (latest o una versión concreta).
SERVER_VERSION=latest

# Límite de mensajes pendientes por dispositivo (0 = sin límite).
QUEUE_MAX_PENDING=0

# --- Servicio "campaigns" (mensajes programados + API de envíos) ---
# Acceso a la web (superusuario de PocketBase).
PB_ADMIN_EMAIL=tu@correo.com
PB_ADMIN_PASSWORD=cambia-esto
# Clave para la API de envíos (cabecera X-API-Key). Genérala con openssl rand -base64 32
CAMPAIGNS_API_KEY=cambia-esto
# Usuario y contraseña que muestra la app de la tablet en Home > Cloud server.
GATEWAY_API_USER=
GATEWAY_API_PASS=
# Opcional (bajas por SMS "BAJA"): URL pública de la web y un secreto aleatorio.
CAMPAIGNS_PUBLIC_URL=
CAMPAIGNS_WEBHOOK_SECRET=
# Opcional: zona horaria (minutos respecto a UTC), pausa mínima y tope diario.
TZ_OFFSET_MIN=-360
MIN_DELAY_FLOOR=20
MAX_PER_DAY=150
